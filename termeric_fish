# termeric — Golden prompts for your terminal (fish)
# Source: source ~/.termeric_fish
#
# Configuration (set before sourcing):
#   set -g PROMPT_COLOR on        Master color switch: on (default) or off
#   set -g PROMPT_STYLE 0         Prompt style: 0=powerline, 1=basename, 2=abbreviated, 3=full path, 4=long text (default: 0)
#   set -g PROMPT_SHOW_USER on    Show user@host segment (default: on)
#   set -g PROMPT_SHOW_EXIT on    Show exit code on failure (default: on)
#   set -g PROMPT_SHOW_DIR on     Show directory path (default: on)
#   set -g PROMPT_SHOW_SSH on     Show SSH indicator when connected (default: on)
#   set -g PROMPT_SHOW_TIME off   Show command duration when >=2s (default: off)
#   set -g PROMPT_VENV off        Show Python virtualenv/conda name (default: off)
#   set -g PROMPT_NODE off        Show Node.js version (default: off)
#   set -g PROMPT_K8S off         Show Kubernetes context (default: off)
#   ai (shell function)           AI agent with Groq/Ollama/OpenAI (run 'ai help' in shell)

# ── Defaults ────────────────────────────────────────────────────
set -q PROMPT_COLOR; or set -g PROMPT_COLOR on
set -q PROMPT_STYLE; or set -g PROMPT_STYLE 0
set -q PROMPT_SHOW_USER; or set -g PROMPT_SHOW_USER on
set -q PROMPT_SHOW_EXIT; or set -g PROMPT_SHOW_EXIT on
set -q PROMPT_SHOW_DIR; or set -g PROMPT_SHOW_DIR on
set -q PROMPT_SHOW_SSH; or set -g PROMPT_SHOW_SSH on
set -q PROMPT_SHOW_TIME; or set -g PROMPT_SHOW_TIME off
set -q PROMPT_VENV; or set -g PROMPT_VENV off
set -q PROMPT_NODE; or set -g PROMPT_NODE off
set -q PROMPT_K8S; or set -g PROMPT_K8S off

# ── Term detection (once) ──────────────────────────────────────
switch $TERM
    case 'xterm-color' '*-256color' '*-truecolor'
        set -g _tmerm_color yes
    case '*'
        set -g _tmerm_color no
end

# ── Window title flag ──────────────────────────────────────────
switch $TERM
    case 'xterm*' 'rxvt*'
        set -g _tmerm_has_title yes
    case '*'
        set -g _tmerm_has_title no
end

# ── Hostname cache (one fork at source time) ────────────────────
set -g _tmerm_hostname (hostname -s 2>/dev/null; or hostname 2>/dev/null)

# ── Validate PROMPT_STYLE ───────────────────────────────────────
switch "$PROMPT_STYLE"
    case 0 1 2 3 4
    case '*'
        echo "termeric: invalid PROMPT_STYLE=$PROMPT_STYLE, defaulting to 1" >&2
        echo "  Valid styles:" >&2
        echo "    0  Powerline (background segments, arrows)" >&2
        echo "    1  Basename only" >&2
        echo "    2  Abbreviated path" >&2
        echo "    3  Full path (~/project/path)" >&2
        echo "    4  Long text prompt (user@host path git)" >&2
        set -g PROMPT_STYLE 1
end

# ── Color definitions (runs at source time and on PROMPT_COLOR change) ──
function __tmerm_init_colors
    if test "$PROMPT_COLOR" != off
        # Powerline backgrounds
        set -g BG_OK      (set_color -b 3C3C3C)
        set -g BG_FAIL    (set_color -b 3C3C3C)
        set -g BG_USER    (set_color -b 3264DC)
        set -g BG_PATH    (set_color -b 00BEBE)
        set -g BG_GIT     (set_color -b DCB400)
        set -g BG_VENV    (set_color -b 46B464)
        set -g BG_NODE    (set_color -b 3CA078)
        set -g BG_K8S     (set_color -b 3C78C8)
        set -g BG_TIME    (set_color -b C832C8)

        # Arrow foregrounds (match previous segment bg)
        set -g ARROW_OK     (set_color 00D200)
        set -g ARROW_FAIL   (set_color DC3232)
        set -g ARROW_USER   (set_color 3264DC)
        set -g ARROW_PATH   (set_color 00BEBE)
        set -g ARROW_GIT    (set_color DCB400)
        set -g ARROW_VENV   (set_color 46B464)
        set -g ARROW_NODE   (set_color 3CA078)
        set -g ARROW_K8S    (set_color 3C78C8)
        set -g ARROW_TIME   (set_color C832C8)
        set -g ARROW_DARK   (set_color 3C3C3C)

        # Text on backgrounds
        set -g TXT_BG     (set_color FFFFFF)
        set -g TXT_BG_LIT (set_color 000000)

        # Text-mode foregrounds
        set -g TXT_OK     (set_color green)
        set -g TXT_FAIL   (set_color red --bold)
        set -g RCOLOR     (set_color normal)
        set -g PROMPT_SEP_GREEN (set_color green)
        set -g TXT_USER   (set_color green)
        set -g TXT_PATH   (set_color blue)
        set -g TXT_GIT    (set_color yellow)
        set -g TXT_VENV   (set_color green)
        set -g TXT_NODE   (set_color green)
        set -g TXT_K8S    (set_color blue)
        set -g TXT_TIME   (set_color cyan)

        # Reset
        set -g R (set_color normal)

        # Powerline separator
        set -g PSEP 
        set -g PSEP_LEFT 
    else
        set -g BG_OK "";    set -g ARROW_OK ""
        set -g BG_FAIL "";  set -g ARROW_FAIL ""
        set -g BG_USER "";  set -g ARROW_USER ""
        set -g BG_PATH "";  set -g ARROW_PATH ""
        set -g BG_GIT "";   set -g ARROW_GIT ""
        set -g BG_VENV "";  set -g ARROW_VENV ""
        set -g BG_NODE "";  set -g ARROW_NODE ""
        set -g BG_K8S "";   set -g ARROW_K8S ""
        set -g BG_TIME "";  set -g ARROW_TIME ""
        set -g ARROW_DARK ""
        set -g TXT_BG "";   set -g TXT_BG_LIT ""
        set -g TXT_OK "";   set -g TXT_FAIL ""
        set -g RCOLOR ""
        set -g PROMPT_SEP_GREEN ""
        set -g TXT_USER ""; set -g TXT_PATH ""
        set -g TXT_GIT "";  set -g TXT_VENV ""; set -g TXT_NODE ""; set -g TXT_K8S ""; set -g TXT_TIME ""
        set -g R ""
        set -g PSEP ""
        set -g PSEP_LEFT ""
    end
end

# Run once at startup
if test "$_tmerm_color" = yes
    __tmerm_init_colors
end

# ── Command duration tracking ──────────────────────────────────
set -g __tmerm_timer 0

function __tmerm_cmd_start --on-event fish_preexec
    test "$PROMPT_SHOW_TIME" != off; or return
    set -g __tmerm_timer (date +%s)
end

# ── Path shortening (for PROMPT_STYLE) ─────────────────────────
function __tmerm_shortened_path
    set -l level $argv[1]
    switch "$level"
        case 0 3
            string replace -r "^$HOME" "~" -- (pwd)
        case 1
            basename (pwd)
        case 2
            prompt_pwd
    end
end

# ── Git info via cache ─────────────────────────────────────────
function __tmerm_git_info
    # Fast exit: not in a git repo
    git rev-parse --is-inside-work-tree >/dev/null 2>&1
    or return

    set -l git_dir (git rev-parse --git-dir 2>/dev/null)
    or return

    set -l head_file "$git_dir/HEAD"
    set -l index_file "$git_dir/index"

    # Cache dir (XDG compliant, per-repo via md5 hash of toplevel path)
    set -l repo_hash (git rev-parse --show-toplevel 2>/dev/null | md5 -q 2>/dev/null; or git rev-parse --show-toplevel 2>/dev/null | md5sum | cut -d' ' -f1 2>/dev/null)
    or return
    set -l cache_dir "$XDG_CACHE_HOME"
    test -n "$cache_dir"; or set cache_dir "$HOME/.cache"
    set cache_dir "$cache_dir/termeric"
    mkdir -p "$cache_dir" 2>/dev/null
    set -l cache_file "$cache_dir/$repo_hash.cache"
    set -l result_file "$cache_dir/$repo_hash.result"

    # Check cache validity
    if test -f "$cache_file"
        set -l cached_head (cat "$cache_file" | string split ' ')[1]
        set -l cached_index (cat "$cache_file" | string split ' ')[2]
        set -l cur_head (stat -f '%m' "$head_file" 2>/dev/null; or stat -c '%Y' "$head_file" 2>/dev/null)
        set -l cur_index (stat -f '%m' "$index_file" 2>/dev/null; or stat -c '%Y' "$index_file" 2>/dev/null)
        if test "$cur_head" = "$cached_head"; and test "$cur_index" = "$cached_index"
            if test -f "$result_file"
                cat "$result_file"
                return
            end
        end
    end

    # Cache miss — compute git status
    set -l branch ""
    set -l staged 0
    set -l unstaged 0
    set -l untracked 0
    set -l ahead 0
    set -l behind 0

    while read -l line
        if string match -q '## '* "$line"
            set -l branch_line (string replace '## ' '' "$line")
            set -l branch_parts (string split '...' "$branch_line")
            set -l branch "$branch_parts[1]"
            if string match -qr 'ahead ([0-9]+)' "$branch_line"
                set -l ahead (string match -r 'ahead ([0-9]+)' "$branch_line" | tail -1)
            end
            if string match -qr 'behind ([0-9]+)' "$branch_line"
                set -l behind (string match -r 'behind ([0-9]+)' "$branch_line" | tail -1)
            end
        else if string match -q '?? '* "$line"
            set untracked (math $untracked + 1)
        else
            set -l x (string sub -l 1 "$line")
            set -l y (string sub -s 2 -l 1 "$line")
            switch "$x"
                case M A D R C
                    set staged (math $staged + 1)
            end
            switch "$y"
                case M A D R C
                    set unstaged (math $unstaged + 1)
            end
        end
    end < (git status --porcelain -b 2>/dev/null | psub)

    test -z "$branch"; and return

    set -l out " $branch"
    set -l details ""

    test $ahead -gt 0; and set details "$details $ahead "
    test $behind -gt 0; and set details "$details $behind "
    test $staged -gt 0; and set details "$details $staged "
    test $unstaged -gt 0; and set details "$details $unstaged "
    test $untracked -gt 0; and set details "$details $untracked "
    set details (string trim "$details")

    test -n "$details"; and set out "$out $details"

    printf '%s' "$out"

    # Write cache
    set -l cur_head (stat -f '%m' "$head_file" 2>/dev/null; or stat -c '%Y' "$head_file" 2>/dev/null)
    set -l cur_index (stat -f '%m' "$index_file" 2>/dev/null; or stat -c '%Y' "$index_file" 2>/dev/null)
    printf '%s %s\n' "$cur_head" "$cur_index" > "$cache_file"
    printf '%s' "$out" > "$result_file"
    # Clean up old per-repo cache files
    rm -f "$git_dir/.termeric_cache" "$git_dir/.termeric_result" 2>/dev/null
end

# ── Virtual environment info ────────────────────────────────────
function __tmerm_venv_info
    set -l venv ""
    if set -q VIRTUAL_ENV; and test -n "$VIRTUAL_ENV"
        set venv (basename "$VIRTUAL_ENV")
    end
    if test -z "$venv"; and set -q CONDA_DEFAULT_ENV; and test -n "$CONDA_DEFAULT_ENV"
        set venv "$CONDA_DEFAULT_ENV"
    end
    if test -n "$venv"
        printf ' %s' "$venv"
    end
end

# ── Node.js version info ────────────────────────────────────────
function __tmerm_node_info
    type -q node; or return
    set -l ver (node --version 2>/dev/null; or return)
    printf ' %s' (string sub -s 2 "$ver")
end

# ── Kubernetes context info ─────────────────────────────────────
function __tmerm_k8s_info
    type -q kubectl; or return
    set -l ctx (kubectl config current-context 2>/dev/null; or return)
    set -l ns (kubectl config view --minify -o jsonpath='{..namespace}' 2>/dev/null)
    if test -n "$ns"
        printf '☸ %s:%s' "$ctx" "$ns"
    else
        printf '☸ %s' "$ctx"
    end
end

# ── Prompt builder ──────────────────────────────────────────────
function fish_prompt
    set -l rc $status
    set -l data ""
    set -l style "$PROMPT_STYLE"

    # Runtime style validation
    switch "$style"
        case 0 1 2 3 4
        case '*'
            if not set -q _tmerm_style_warned
                echo "termeric: invalid PROMPT_STYLE=$style, defaulting to 1" >&2
                echo "  Valid styles:" >&2
                echo "    0  Powerline (background segments, arrows)" >&2
                echo "    1  Basename only" >&2
                echo "    2  Abbreviated path" >&2
                echo "    3  Full path (~/project/path)" >&2
                echo "    4  Long text prompt (user@host path git)" >&2
                set -g _tmerm_style_warned 1
            end
            set style 1
    end

    # Window title
    if test "$_tmerm_has_title" = yes
        set data "\033]0;$USER@$_tmerm_hostname: "(pwd)"\a"
    end

    # Initialize colors if terminal supports it
    if test "$_tmerm_color" = yes
        __tmerm_init_colors
    end

    # Style 4: long text prompt without background colors
    if test "$style" = 4
        if test $rc -ne 0; and test "$PROMPT_SHOW_EXIT" != off
            set data "$data$TXT_FAIL✘ $rc$RCOLOR "
        end
        if test "$PROMPT_SHOW_USER" != off
            if test "$PROMPT_SHOW_SSH" != off; and test -n "$SSH_CONNECTION"
                set data "$data$TXT_USER$USER@ssh:$_tmerm_hostname$RCOLOR "
            else
                set data "$data$TXT_USER$USER@$_tmerm_hostname$RCOLOR "
            end
        end
        if test "$PROMPT_SHOW_DIR" != off
            set data "$data$TXT_PATH"(prompt_pwd)"$RCOLOR"
        end
        set -l git_info (__tmerm_git_info 2>/dev/null)
        if test -n "$git_info"
            set data "$data $TXT_GIT$git_info$RCOLOR"
        end
        set -l venv_info (__tmerm_venv_info 2>/dev/null)
        if test -n "$venv_info"
            set data "$data $TXT_VENV$venv_info$RCOLOR"
        end
        set -l node_info (__tmerm_node_info 2>/dev/null)
        if test -n "$node_info"
            set data "$data $TXT_NODE$node_info$RCOLOR"
        end
        set -l k8s_info (__tmerm_k8s_info 2>/dev/null)
        if test -n "$k8s_info"
            set data "$data $TXT_K8S$k8s_info$RCOLOR"
        end
        if test "$PROMPT_SHOW_TIME" != off; and test $__tmerm_timer -gt 0
            set -l duration (math (date +%s) - $__tmerm_timer)
            if test $duration -ge 2
                set data "$data $TXT_TIME[$duration s]$RCOLOR"
            end
        end
        printf '%b\n' "$data"
        if test -n "$PROMPT_SEP_GREEN"
            set_color green
        end
        printf '%s\n' '❯❯ '
        if test -n "$PROMPT_SEP_GREEN"
            set_color normal
        end
        set -g __tmerm_timer 0
        return
    end

    # Styles 1, 2: shortened path prompts
    if test "$style" != 0
        set -l spath (__tmerm_shortened_path $style)
        if test $rc -ne 0; and test "$PROMPT_SHOW_EXIT" != off
            set data "$data$TXT_FAIL✘ $rc$RCOLOR "
        end
        if test "$PROMPT_SHOW_DIR" != off
            set data "$data$TXT_PATH  $spath$RCOLOR"
        else
            set data "$data$TXT_PATH$spath$RCOLOR"
        end
        set -l git_info (__tmerm_git_info 2>/dev/null)
        if test -n "$git_info"
            set data "$data $TXT_GIT$git_info$RCOLOR"
        end
        set -l venv_info (__tmerm_venv_info 2>/dev/null)
        if test -n "$venv_info"
            set data "$data $TXT_VENV$venv_info$RCOLOR"
        end
        set -l node_info (__tmerm_node_info 2>/dev/null)
        if test -n "$node_info"
            set data "$data $TXT_NODE$node_info$RCOLOR"
        end
        set -l k8s_info (__tmerm_k8s_info 2>/dev/null)
        if test -n "$k8s_info"
            set data "$data $TXT_K8S$k8s_info$RCOLOR"
        end
        printf '%b\n' "$data"
        if test -n "$PROMPT_SEP_GREEN"
            set_color green
        end
        printf '%s\n' '❯❯ '
        if test -n "$PROMPT_SEP_GREEN"
            set_color normal
        end
        set -g __tmerm_timer 0
        return
    end

    # Style 0: powerline or monochrome
    if test "$_tmerm_color" = yes; and test "$PROMPT_COLOR" != off
        # ── POWERLINE MODE ──
        set -l arrow ""

        # Exit code (only show on failure) — first segment
        if test $rc -ne 0; and test "$PROMPT_SHOW_EXIT" != off
            set data "$data$BG_FAIL $BG_FAIL$ARROW_DARK$PSEP$BG_FAIL$TXT_FAIL ✘ $rc $R"
            set arrow "$ARROW_DARK"
        end

        # Session
        if test "$PROMPT_SHOW_USER" != off
            if test -n "$arrow"
                set data "$data$BG_USER$arrow$PSEP$R$BG_USER$TXT_BG"
            else
                set data "$data$BG_FAIL $BG_USER$ARROW_DARK$PSEP$BG_USER$TXT_BG"
            end
            if test "$PROMPT_SHOW_SSH" != off; and test -n "$SSH_CONNECTION"
                set data "$data $USER@ssh:$_tmerm_hostname $R"
            else
                set data "$data $USER@$_tmerm_hostname $R"
            end
            set arrow "$ARROW_USER"
        end

        # Path
        if test "$PROMPT_SHOW_DIR" != off
            if test -n "$arrow"
                set data "$data$BG_PATH$arrow$PSEP$R$BG_PATH$TXT_BG_LIT"
            else
                set data "$data$BG_FAIL $BG_PATH$ARROW_DARK$PSEP$BG_PATH$TXT_BG_LIT"
            end
            set data "$data "(prompt_pwd)" $R"
            set arrow "$ARROW_PATH"
        end

        # Git
        set -l git_info (__tmerm_git_info 2>/dev/null)
        if test -n "$git_info"
            if test -n "$arrow"
                set data "$data$BG_GIT$arrow$PSEP$R$BG_GIT$TXT_BG_LIT"
            else
                set data "$data$BG_FAIL $BG_GIT$ARROW_DARK$PSEP$BG_GIT$TXT_BG_LIT"
            end
            set data "$data $git_info $R"
            set arrow "$ARROW_GIT"
        end

        # Virtual env
        if test "$PROMPT_VENV" != off
            set -l venv_info (__tmerm_venv_info 2>/dev/null)
            if test -n "$venv_info"
                if test -n "$arrow"
                    set data "$data$BG_VENV$arrow$PSEP$R$BG_VENV$TXT_BG"
                else
                    set data "$data$BG_FAIL $BG_VENV$ARROW_DARK$PSEP$BG_VENV$TXT_BG"
                end
                set data "$data $venv_info $R"
                set arrow "$ARROW_VENV"
            end
        end

        # Node.js
        if test "$PROMPT_NODE" != off
            set -l node_info (__tmerm_node_info 2>/dev/null)
            if test -n "$node_info"
                if test -n "$arrow"
                    set data "$data$BG_NODE$arrow$PSEP$R$BG_NODE$TXT_BG"
                else
                    set data "$data$BG_FAIL $BG_NODE$ARROW_DARK$PSEP$BG_NODE$TXT_BG"
                end
                set data "$data $node_info $R"
                set arrow "$ARROW_NODE"
            end
        end

        # Kubernetes
        if test "$PROMPT_K8S" != off
            set -l k8s_info (__tmerm_k8s_info 2>/dev/null)
            if test -n "$k8s_info"
                if test -n "$arrow"
                    set data "$data$BG_K8S$arrow$PSEP$R$BG_K8S$TXT_BG"
                else
                    set data "$data$BG_FAIL $BG_K8S$ARROW_DARK$PSEP$BG_K8S$TXT_BG"
                end
                set data "$data $k8s_info $R"
                set arrow "$ARROW_K8S"
            end
        end

        # Timing
        if test "$PROMPT_SHOW_TIME" != off; and test $__tmerm_timer -gt 0
            set -l duration (math (date +%s) - $__tmerm_timer)
            if test $duration -ge 2
                if test -n "$arrow"
                    set data "$data$BG_TIME$arrow$PSEP$R$BG_TIME$TXT_BG"
                else
                    set data "$data$BG_FAIL $BG_TIME$ARROW_DARK$PSEP$BG_TIME$TXT_BG"
                end
                set data "$data $duration s $R"
                set arrow "$ARROW_TIME"
            end
        end

        # Trailing separator
        if test -n "$arrow"
            set data "$data$arrow$PSEP$R"
        end

        # Output line 1
        printf '%b' "$data"

        # Line 2
        if test -n "$PROMPT_SEP_GREEN"
            set_color green
        end
        printf '\n%s' '❯❯ '
        if test -n "$PROMPT_SEP_GREEN"
            set_color normal
        end
    else
        # ── MONOCHROME MODE ──
        set -l mono ""

        if test $rc -ne 0; and test "$PROMPT_SHOW_EXIT" != off
            set mono "✘ $rc "
        end

        if test "$PROMPT_SHOW_USER" != off
            if test "$PROMPT_SHOW_SSH" != off; and test -n "$SSH_CONNECTION"
                set mono "$mono$USER@ssh:$_tmerm_hostname:"
            else
                set mono "$mono$USER@$_tmerm_hostname:"
            end
        end

        if test "$PROMPT_SHOW_DIR" != off
            set mono "$mono"(prompt_pwd)
        end

        set -l git_info (__tmerm_git_info 2>/dev/null)
        if test -n "$git_info"
            set mono "$mono ($git_info)"
        end

        set -l venv_info (__tmerm_venv_info 2>/dev/null)
        if test -n "$venv_info"
            set mono "$mono $venv_info"
        end
        set -l node_info (__tmerm_node_info 2>/dev/null)
        if test -n "$node_info"
            set mono "$mono $node_info"
        end
        set -l k8s_info (__tmerm_k8s_info 2>/dev/null)
        if test -n "$k8s_info"
            set mono "$mono $k8s_info"
        end

        if test "$PROMPT_SHOW_TIME" != off; and test $__tmerm_timer -gt 0
            set -l duration (math (date +%s) - $__tmerm_timer)
            if test $duration -ge 2
                set mono "$mono [$duration s]"
            end
        end

        printf '%s\n%s' "$mono" '❯❯ '
    end

    set -g __tmerm_timer 0
end

# ── AI agent ────────────────────────────────────────────────────
function ai --description "Talk to the AI agent from your shell"
    if test (count $argv) -eq 0
        echo "Usage: ai <query>"
        echo "  Talk to the AI agent directly from your shell"
        return 1
    end
    set -l cmd (command -v termeric 2>/dev/null; or echo "$HOME/.local/bin/termeric")
    if not test -x "$cmd"
        echo "termeric not found in PATH. Run 'termeric install' first." >&2
        return 1
    end
    eval $cmd ai agent $argv
end

# ── / prefix intercept ─────────────────────────────────────────
function _termeric_preexec --on-event fish_preexec
    if string match -r '^/(.+)$' -- $argv[1] &>/dev/null
        ai (string replace -r '^/(.+)$' '$1' -- $argv[1])
        return 1
    end
end
