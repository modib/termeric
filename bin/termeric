#!/usr/bin/env bash
set -euo pipefail

TERMERIC_VERSION="1.7.0"
TERMERIC_DIR="$(cd "$(dirname "$0")/.." && pwd)"

# Detect share directory (Homebrew pkgshare puts files under share/termeric/)
TERMERIC_SHARE="$TERMERIC_DIR"
if [ ! -f "$TERMERIC_SHARE/termeric_bash" ] && [ -d "$TERMERIC_DIR/share/termeric" ]; then
	TERMERIC_SHARE="$TERMERIC_DIR/share/termeric"
fi

# ── Colors ──────────────────────────────────────────────────────
if [ -t 1 ]; then
	GOLD='\033[38;2;220;180;0m'
	GREEN='\033[32m'
	RED='\033[31m'
	CYAN='\033[36m'
	BOLD='\033[1m'
	RESET='\033[0m'
else
	GOLD='' GREEN='' RED='' CYAN='' BOLD='' RESET=''
fi

# ── Helpers ─────────────────────────────────────────────────────
_info() { printf "%b %b\n" "${CYAN}▸${RESET}" "$*"; }
_ok() { printf "%b %b\n" "${GREEN}✓${RESET}" "$*"; }
_warn() { printf "%b %b\n" "${GOLD}⚠${RESET}" "$*"; }
_err() { printf "%b %b\n" "${RED}✗${RESET}" "$*" >&2; }

_show_help() {
	printf "%b\n" \
		"${GOLD}${BOLD}termeric${RESET} — Golden prompts for your terminal" \
		"" \
		"${BOLD}Usage:${RESET}" \
		"  termeric <command> [options]" \
		"" \
		"${BOLD}Commands:${RESET}" \
		"  install       Install termeric to current shell" \
		"  uninstall     Remove termeric from shell config" \
		"  update        Pull latest version and reinstall" \
		"  config        Open config in \$EDITOR" \
		"  status        Show current settings and diagnostics" \
		"  ai            AI agent commands (agent/config/doctor)" \
		"  clear-cache   Clear cached git status data" \
		"  font          Install Meslo Nerd Font" \
		"  doctor        Check system compatibility" \
		"  version       Show version" \
		"  help, -h, --help" \
		"                Show this message" \
		"" \
		"${BOLD}Examples:${RESET}" \
		"  termeric install           # quick setup" \
		"  termeric install --font    # setup with Nerd Font" \
		"  termeric status            # check what's active" \
		"  termeric doctor            # verify system readiness" \
		"" \
		"${BOLD}Configuration:${RESET}" \
		"  Set these before sourcing termeric:" \
		"" \
		"    PROMPT_COLOR=on        Master color switch: on (default) or off" \
		"    PROMPT_SHOW_USER=on    Show user@host segment (default: on)" \
		"    PROMPT_SHOW_EXIT=on    Show exit code on failure (default: on)" \
		"    PROMPT_SHOW_DIR=on     Show directory path (default: on)" \
		"    PROMPT_SHOW_SSH=on     Show SSH indicator when connected (default: on)" \
		"    PROMPT_SHOW_TIME=off   Show command duration when >=2s (default: off)" \
		"    PROMPT_VENV=off        Show Python virtualenv/conda name (default: off)" \
		"    PROMPT_NODE=off        Show Node.js version (default: off)" \
		"    PROMPT_K8S=off         Show Kubernetes context (default: off)" \
		"    PROMPT_STYLE=0         Prompt style: 0=powerline, 1=basename, 2=abbreviated," \
		"                           3=full path, 4=long text (default: 0)" \
		"" \
		"${BOLD}Docs:${RESET}" \
		"  https://modib.github.io/termeric/"
}

# ── Detect shell ────────────────────────────────────────────────
_detect_shell() {
	local shell_name
	shell_name="$(basename "${SHELL:-}" 2>/dev/null || true)"
	if [ -z "$shell_name" ]; then
		shell_name="$(basename "$(ps -p $$ -o comm= 2>/dev/null)" 2>/dev/null || echo "bash")"
	fi
	echo "$shell_name"
}

# ── Read configured toggle value from shell rc file ───────────
_get_rc_val() {
	local var="$1"
	local shell_name="$2"
	shift 2
	local rc_file=""
	case "$shell_name" in
	bash) rc_file="$HOME/.bashrc" ;;
	zsh | zsh-*) rc_file="$HOME/.zshrc" ;;
	fish) rc_file="$HOME/.config/fish/config.fish" ;;
	*) return 0 ;;
	esac
	[ -f "$rc_file" ] || return 0
	local val=""
	# bash/zsh: PROMPT_STYLE=2 or export PROMPT_STYLE=2
	val="$(grep -E "^[[:space:]]*(export[[:space:]]+)?${var}=" "$rc_file" 2>/dev/null | tail -1 | awk -F= '{print $2}' | tr -d "\"'" | tr -d ' ' || true)"
	if [ -z "$val" ]; then
		# fish: set -g PROMPT_STYLE 2
		val="$(grep -E "^[[:space:]]*set -g ${var}[[:space:]]" "$rc_file" 2>/dev/null | tail -1 | awk '{print $NF}' || true)"
	fi
	printf '%s' "$val"
}

_get_style_desc() {
	case "${1:-0}" in 0) echo "powerline" ;; 1) echo "basename" ;; 2) echo "abbreviated" ;; 3) echo "full path" ;; 4) echo "long text" ;; esac
}

# ── Install ─────────────────────────────────────────────────────
_cmd_install() {
	local install_font=0
	for arg in "$@"; do
		case "$arg" in
		--font) install_font=1 ;;
		--help | -h)
			_show_help
			exit 0
			;;
		*)
			_err "Unknown option: $arg"
			_show_help
			exit 1
			;;
		esac
	done

	local shell_name
	shell_name="$(_detect_shell)"
	_info "Detected shell: ${BOLD}$shell_name${RESET}"

	# Install bash config
	if [ -f "$TERMERIC_SHARE/termeric_bash" ]; then
		cp "$TERMERIC_SHARE/termeric_bash" "$HOME/.termeric_bash"
		_ok "Copied termeric_bash to ~/.termeric_bash"

		if ! grep -qxF '[ -f ~/.termeric_bash ] && . ~/.termeric_bash' "$HOME/.bashrc" 2>/dev/null; then
			{
				echo "# termeric — golden prompt"
				echo 'if [ -f ~/.termeric_bash ]; then'
				echo '    . ~/.termeric_bash'
				echo 'fi'
			} >>"$HOME/.bashrc"
			_ok "Added source line to ~/.bashrc"
		else
			_info "~/.bashrc already sources termeric_bash"
		fi
	fi

	# Install zsh config
	if [ -f "$TERMERIC_SHARE/termeric_zsh" ]; then
		cp "$TERMERIC_SHARE/termeric_zsh" "$HOME/.termeric_zsh"
		_ok "Copied termeric_zsh to ~/.termeric_zsh"

		# Check for existing termeric source lines (prevent duplication)
		local zsh_already=0
		if [ -f "$HOME/.zshrc" ] && grep -qF '~/.termeric_zsh' "$HOME/.zshrc" 2>/dev/null; then
			zsh_already=1
		fi

		if [ "$zsh_already" -eq 0 ]; then
			# Check for conflicting prompt customizations
			local conflicts=""
			if [ -f "$HOME/.zshrc" ]; then
				if grep -q "oh-my-zsh\|oh-my-zsh.sh" "$HOME/.zshrc" 2>/dev/null; then
					conflicts="${conflicts}  - oh-my-zsh detected\n"
				fi
				if grep -q "powerlevel10k\|p10k" "$HOME/.zshrc" 2>/dev/null; then
					conflicts="${conflicts}  - powerlevel10k detected\n"
				fi
				if grep -q "starship" "$HOME/.zshrc" 2>/dev/null; then
					conflicts="${conflicts}  - starship detected\n"
				fi
				if grep -q "pure\|sindresorhus/pure" "$HOME/.zshrc" 2>/dev/null; then
					conflicts="${conflicts}  - pure prompt detected\n"
				fi
				if grep -q "agnoster" "$HOME/.zshrc" 2>/dev/null; then
					conflicts="${conflicts}  - agnoster theme detected\n"
				fi
				# Check for generic PROMPT manipulation
				if grep -qE "^(PROMPT=|setopt.*PROMPT|prompt_)" "$HOME/.zshrc" 2>/dev/null; then
					conflicts="${conflicts}  - custom PROMPT setting detected\n"
				fi
			fi

			if [ -n "$conflicts" ]; then
				_warn "Conflicting prompt customizations found in ~/.zshrc:"
				printf "$conflicts"
				_info "Termeric will be added, but you may need to comment out conflicting lines."
			fi

			{
				echo "# termeric — golden prompt"
				echo 'if [ -f ~/.termeric_zsh ]; then'
				echo '    . ~/.termeric_zsh'
				echo 'fi'
			} >>"$HOME/.zshrc"
			_ok "Added source line to ~/.zshrc"
		else
			_info "~/.zshrc already sources termeric"
		fi
	fi

	# Install fish config
	if [ -f "$TERMERIC_SHARE/termeric_fish" ]; then
		local fish_config_dir="$HOME/.config/fish"
		mkdir -p "$fish_config_dir"
		cp "$TERMERIC_SHARE/termeric_fish" "$fish_config_dir/termeric_fish"
		_ok "Copied termeric_fish to ~/.config/fish/termeric_fish"

		local fish_config="$fish_config_dir/config.fish"
		if ! grep -qxF 'source ~/.config/fish/termeric_fish' "$fish_config" 2>/dev/null; then
			{
				echo "# termeric — golden prompt"
				echo 'source ~/.config/fish/termeric_fish'
			} >>"$fish_config"
			_ok "Added source line to ~/.config/fish/config.fish"
		else
			_info "~/.config/fish/config.fish already sources termeric_fish"
		fi
	fi

	# Install CLI to PATH if not already there
	if [ ! -x "$HOME/.local/bin/termeric" ] && [ "$TERMERIC_DIR/bin/termeric" != "$(which termeric 2>/dev/null || echo none)" ]; then
		mkdir -p "$HOME/.local/bin"
		ln -sf "$TERMERIC_DIR/bin/termeric" "$HOME/.local/bin/termeric"
		_ok "Symlinked termeric to ~/.local/bin/"

		case ":$PATH:" in
		*":$HOME/.local/bin:"*) ;;
		*) _warn "Add ~/.local/bin to your PATH:\n  export PATH=\"\$HOME/.local/bin:\$PATH\"" ;;
		esac
	fi

	# Font
	if [ "$install_font" -eq 1 ]; then
		_cmd_font
	fi

	echo ""
	_ok "Termeric installed!"

	# Source the rc file for immediate effect
	case "$shell_name" in
	zsh | bash)
		_info "Run ${BOLD}source ~/.${shell_name}rc${RESET} or open a new terminal."
		;;
	*)
		_info "Run ${BOLD}exec $shell_name${RESET} or open a new terminal."
		;;
	esac
	_info "Run ${BOLD}termeric doctor${RESET} to verify your setup and see toggle states."
}

# ── Uninstall ───────────────────────────────────────────────────
_cmd_uninstall() {
	_info "Removing termeric..."

	rm -f "$HOME/.termeric_bash" "$HOME/.termeric_zsh" "$HOME/.termeric_fish"

	# Remove source lines from bash/zsh
	for rc_file in "$HOME/.bashrc" "$HOME/.zshrc"; do
		if [ -f "$rc_file" ]; then
			# Remove new-style block (comment marker)
			if grep -q '# termeric — golden prompt' "$rc_file" 2>/dev/null; then
				# Remove blank line + block (handles old accumulated blanks)
				sed -i.bak '$!{ /^$/{ N; /\n# termeric — golden prompt/d; P; D; }; }' "$rc_file" 2>/dev/null ||
					sed -i '' '$!{ /^$/{ N; /\n# termeric — golden prompt/d; P; D; }; }' "$rc_file" 2>/dev/null || true
				rm -f "${rc_file}.bak"
				sed -i.bak '/# termeric — golden prompt/,+3d' "$rc_file" 2>/dev/null ||
					sed -i '' '/# termeric — golden prompt/,+3d' "$rc_file" 2>/dev/null || true
				rm -f "${rc_file}.bak"
			fi
			# Fallback: remove old-style block without comment marker
			if grep -Eq '^if \[ -f ~/\.termeric_(bash|zsh) \]; then$' "$rc_file" 2>/dev/null; then
				sed -i.bak '/^if \[ -f ~\/\.termeric_bash \]; then$/,+3d' "$rc_file" 2>/dev/null ||
					sed -i '' '/^if \[ -f ~\/\.termeric_bash \]; then$/,+3d' "$rc_file" 2>/dev/null || true
				rm -f "${rc_file}.bak"
				sed -i.bak '/^if \[ -f ~\/\.termeric_zsh \]; then$/,+3d' "$rc_file" 2>/dev/null ||
					sed -i '' '/^if \[ -f ~\/\.termeric_zsh \]; then$/,+3d' "$rc_file" 2>/dev/null || true
				rm -f "${rc_file}.bak"
			fi
		fi
	done

	# Remove fish config
	local fish_config_dir="$HOME/.config/fish"
	rm -f "$fish_config_dir/termeric_fish"
	if [ -f "$fish_config_dir/config.fish" ]; then
		# Remove new-style block (comment marker)
		if grep -q '# termeric — golden prompt' "$fish_config_dir/config.fish" 2>/dev/null; then
			sed -i.bak '$!{ /^$/{ N; /\n# termeric — golden prompt/d; P; D; }; }' "$fish_config_dir/config.fish" 2>/dev/null ||
				sed -i '' '$!{ /^$/{ N; /\n# termeric — golden prompt/d; P; D; }; }' "$fish_config_dir/config.fish" 2>/dev/null || true
			rm -f "${fish_config_dir}/config.fish.bak"
			sed -i.bak '/# termeric — golden prompt/,+1d' "$fish_config_dir/config.fish" 2>/dev/null ||
				sed -i '' '/# termeric — golden prompt/,+1d' "$fish_config_dir/config.fish" 2>/dev/null || true
			rm -f "${fish_config_dir}/config.fish.bak"
		fi
		# Fallback: remove old-style source line without comment marker
		if grep -q '^source ~/\.config/fish/termeric_fish$' "$fish_config_dir/config.fish" 2>/dev/null; then
			sed -i.bak '/^source ~\/\.config\/fish\/termeric_fish$/d' "$fish_config_dir/config.fish" 2>/dev/null ||
				sed -i '' '/^source ~\/\.config\/fish\/termeric_fish$/d' "$fish_config_dir/config.fish" 2>/dev/null || true
			rm -f "${fish_config_dir}/config.fish.bak"
		fi
	fi

	rm -f "$HOME/.local/bin/termeric"

	# Clean up cached git status files
	local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/termeric"
	[ -d "$cache_dir" ] && rm -rf "$cache_dir" && _info "Removed git cache at $cache_dir"

	_ok "Termeric removed. Restart your shell for changes to take effect."
}

# ── Update ──────────────────────────────────────────────────────
_cmd_update() {
	_info "Updating termeric..."
	if [ -d "$TERMERIC_DIR/.git" ]; then
		git -C "$TERMERIC_DIR" pull --rebase --quiet
		_cmd_install
		_ok "Updated to latest version"
	else
		_err "Not a git repository. Reinstall manually or clone from https://github.com/modib/termeric"
		exit 1
	fi
}

# ── Config ──────────────────────────────────────────────────────
_cmd_config() {
	local config_file="${TERMERIC_CONFIG:-$HOME/.termericrc}"
	if [ ! -f "$config_file" ]; then
		cat >"$config_file" <<'CONF'
# termeric configuration
# Set these to override defaults

# PROMPT_COLOR=on        # Master color switch (on/off)
# PROMPT_STYLE=0         # Prompt style: 0=powerline, 1=basename, 2=abbreviated, 3=full path, 4=long text
# PROMPT_SHOW_USER=on    # Show user@host segment (on/off)
# PROMPT_SHOW_EXIT=on    # Show exit code on failure (on/off)
# PROMPT_SHOW_DIR=on     # Show directory path (on/off)
# PROMPT_SHOW_SSH=on     # Show SSH indicator (on/off)
# PROMPT_SHOW_TIME=off   # Show command duration (on/off)
# PROMPT_VENV=off        # Show Python virtualenv/conda name (on/off)
# PROMPT_NODE=off        # Show Node.js version (on/off)
# PROMPT_K8S=off         # Show Kubernetes context (on/off)
CONF
		_info "Created config at $config_file"
	fi
	"${EDITOR:-vi}" "$config_file"
}

# ── Status ──────────────────────────────────────────────────────
_cmd_status() {
	echo ""
	printf "%b%b%b" "${GOLD}${BOLD}" "termeric v${TERMERIC_VERSION}" "${RESET}\n"
	echo "─────────────────────────────────────"

	# Shell
	local shell_name="$(_detect_shell)"
	printf "  %-18s %s\n" "Shell:" "$shell_name"

	# Active shell files
	local dotfile rc_file
	case "$shell_name" in
	bash)
		dotfile="$HOME/.termeric_bash"
		rc_file="$HOME/.bashrc"
		;;
	zsh)
		dotfile="$HOME/.termeric_zsh"
		rc_file="$HOME/.zshrc"
		;;
	fish)
		dotfile="$HOME/.config/fish/termeric_fish"
		rc_file="$HOME/.config/fish/config.fish"
		;;
	*)
		dotfile=""
		rc_file=""
		;;
	esac

	if [ -n "$dotfile" ]; then
		local dotfile_label="$(basename "$dotfile"):"
		if [ -f "$dotfile" ]; then
			printf "  %-18s ${GREEN}%s${RESET}\n" "$dotfile_label" "installed"
		else
			printf "  %-18s ${RED}%s${RESET}\n" "$dotfile_label" "not found"
		fi
	fi
	if [ -n "$rc_file" ]; then
		local rc_label="$(basename "$rc_file"):"
		if [ -f "$rc_file" ] && grep -q "termeric" "$rc_file" 2>/dev/null; then
			printf "  %-18s ${GREEN}%s${RESET}\n" "$rc_label" "sourced"
		else
			printf "  %-18s ${RED}%s${RESET}\n" "$rc_label" "not sourced"
		fi
	fi

	# Font
	if fc-list 2>/dev/null | grep -qi "meslo.*nerd\|nerd.*meslo" ||
		ls ~/Library/Fonts/ 2>/dev/null | grep -qi "meslo.*nerd\|nerd.*meslo" ||
		ls ~/.local/share/fonts/ 2>/dev/null | grep -qi "meslo.*nerd\|nerd.*meslo"; then
		printf "  %-18s ${GREEN}%s${RESET}\n" "Nerd Font:" "installed"
	else
		printf "  %-18s ${RED}%s${RESET} (run: termeric font)\n" "Nerd Font:" "not installed"
	fi

	# Git cache
	local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/termeric"
	if [ -d "$cache_dir" ]; then
		local count
		count=$(ls "$cache_dir"/*.result 2>/dev/null | wc -l | tr -d ' ')
		if [ "$count" -gt 0 ] 2>/dev/null; then
			printf "  %-18s ${GREEN}%s${RESET}\n" "Git cache:" "${count} repo(s) cached"
		else
			printf "  %-18s ${GOLD}%s${RESET}\n" "Git cache:" "cold"
		fi
		printf "  %-18s %s\n" "Cache dir:" "$cache_dir"
	else
		printf "  %-18s ${GOLD}%s${RESET}\n" "Git cache:" "cold"
		printf "  %-18s %s\n" "Cache dir:" "$cache_dir"
	fi

	# Toggle states
	echo ""
	printf "%b%b%b" "${BOLD}" "Toggle states" "${RESET}\n"

	_show_toggle() {
		local name="$1" default="$2"
		local env_val rc_val env_set
		eval "env_set=\"\${$name+set}\""
		eval "env_val=\"\${$name:-$default}\""
		rc_val="$(_get_rc_val "$name" "$shell_name")"
		local display_val="$env_val"
		if [ "$env_set" != "set" ] && [ -n "$rc_val" ]; then
			display_val="$rc_val"
		fi
		if [ "$display_val" = "off" ] 2>/dev/null; then
			printf "  %-30s (disabled)" "${name}=${display_val}"
		else
			printf "  %-30s (enabled)" "${name}=${display_val}"
		fi
		if [ "$env_set" = "set" ] && [ "$env_val" != "$display_val" ]; then
			printf " (session: %s)" "$env_val"
		fi
		if [ -n "$rc_val" ] && [ "$rc_val" != "$env_val" ]; then
			printf " (rc: %s)" "$rc_val"
		fi
		printf "\n"
	}

	_show_toggle PROMPT_COLOR on
	_show_toggle PROMPT_SHOW_USER on
	_show_toggle PROMPT_SHOW_EXIT on
	_show_toggle PROMPT_SHOW_DIR on
	_show_toggle PROMPT_SHOW_SSH on
	_show_toggle PROMPT_SHOW_TIME off
	_show_toggle PROMPT_VENV off
	_show_toggle PROMPT_NODE off
	_show_toggle PROMPT_K8S off
	_show_toggle PROMPT_STYLE 0

	# AI config status
	local ai_config_file="${XDG_CONFIG_HOME:-$HOME/.config}/termeric/config"
	if [ -f "$ai_config_file" ]; then
		printf "  %-18s ${GREEN}%s${RESET}\n" "AI config:" "found"
	else
		printf "  %-18s ${GOLD}%s${RESET}\n" "AI config:" "not set (run: termeric ai config)"
	fi

	echo ""
}

# ── AI ──────────────────────────────────────────────────────────
_cmd_ai() {
	local ai_script="$TERMERIC_DIR/ai/termeric_ai"
	if [ ! -f "$ai_script" ]; then
		ai_script="$TERMERIC_SHARE/ai/termeric_ai"
	fi
	if [ ! -f "$ai_script" ]; then
		_err "AI module not found at ai/termeric_ai"
		exit 1
	fi
	exec "$ai_script" "$@"
}

# ── Font ────────────────────────────────────────────────────────
_cmd_font() {
	_info "Installing Meslo Nerd Font..."

	if fc-list 2>/dev/null | grep -qi "meslo.*nerd\|nerd.*meslo" ||
		ls ~/Library/Fonts/ 2>/dev/null | grep -qi "meslo.*nerd\|nerd.*meslo" ||
		ls ~/.local/share/fonts/ 2>/dev/null | grep -qi "meslo.*nerd\|nerd.*meslo"; then
		_ok "Meslo Nerd Font already installed"
		return 0
	fi

	# Use bundled fonts if available
	local bundled_dir="$TERMERIC_DIR/fonts"
	if [ -d "$bundled_dir" ] && [ -n "$(ls -A "$bundled_dir"/*.ttf 2>/dev/null)" ]; then
		if [ "$(uname)" = "Darwin" ]; then
			mkdir -p ~/Library/Fonts
			cp "$bundled_dir"/*.ttf ~/Library/Fonts/
			_ok "Installed bundled Meslo Nerd Font to ~/Library/Fonts/"
		else
			mkdir -p ~/.local/share/fonts
			cp "$bundled_dir"/*.ttf ~/.local/share/fonts/
			fc-cache -f 2>/dev/null || true
			_ok "Installed bundled Meslo Nerd Font to ~/.local/share/fonts/"
		fi
	elif command -v brew &>/dev/null; then
		brew install --cask font-meslo-lg-nerd-font
		_ok "Font installed via Homebrew"
	else
		local url="https://github.com/ryanoasis/nerd-fonts/releases/download/v3.4.0/Meslo.zip"
		local tmpdir
		tmpdir="$(mktemp -d)"
		(
			cd "$tmpdir" || exit 1
			curl -fsSL "$url" -o Meslo.zip || wget -q "$url" -O Meslo.zip
			unzip -q Meslo.zip -d meslo-nerd
			if [ "$(uname)" = "Darwin" ]; then
				mkdir -p ~/Library/Fonts
				cp meslo-nerd/*.ttf ~/Library/Fonts/
			else
				mkdir -p ~/.local/share/fonts
				cp meslo-nerd/*.ttf ~/.local/share/fonts/
				fc-cache -f 2>/dev/null || true
			fi
		)
		rm -rf "$tmpdir"
		_ok "Font downloaded and installed"
	fi

	_info "Set your terminal to use 'MesloLGL Nerd Font'."
}

# ── Doctor ──────────────────────────────────────────────────────
_cmd_doctor() {
	echo ""
	printf "%b%b%b" "${GOLD}${BOLD}" "termeric doctor" "${RESET}\n"
	echo "─────────────────────────────────────"

	local issues=0

	# Bash version
	if [ -n "${BASH_VERSION:-}" ]; then
		if [[ "$BASH_VERSION" < "4." ]]; then
			_warn "Bash $BASH_VERSION — version 4+ recommended for best performance"
			issues=$((issues + 1))
		else
			_ok "Bash $BASH_VERSION"
		fi
	fi

	# Zsh
	if command -v zsh &>/dev/null; then
		_ok "zsh $(zsh --version 2>/dev/null | awk '{print $2}')"
	else
		_warn "zsh not found"
	fi

	# Fish
	if command -v fish &>/dev/null; then
		_ok "fish $(fish --version 2>/dev/null | awk '{print $3}')"
	else
		_warn "fish not found"
	fi

	# Git
	if command -v git &>/dev/null; then
		_ok "git $(git --version 2>/dev/null | awk '{print $3}')"
	else
		_err "git not found — required for git prompt features"
		issues=$((issues + 1))
	fi

	# stat (needed for cache)
	if stat --version &>/dev/null 2>&1 || stat -f '%m' /dev/null &>/dev/null 2>&1; then
		_ok "stat (for cache)"
	else
		_warn "stat not available — caching may not work"
	fi

	# Terminal
	case "${TERM:-}" in
	xterm-color | *-256color | *-truecolor)
		_ok "Terminal supports color ($TERM)"
		;;
	*)
		_warn "Terminal may not support truecolor ($TERM)"
		;;
	esac

	# Font
	if fc-list 2>/dev/null | grep -qi "meslo.*nerd\|nerd.*meslo" ||
		ls ~/Library/Fonts/ 2>/dev/null | grep -qi "meslo.*nerd\|nerd.*meslo" ||
		ls ~/.local/share/fonts/ 2>/dev/null | grep -qi "meslo.*nerd\|nerd.*meslo"; then
		_ok "Meslo Nerd Font installed"
	else
		_warn "Meslo Nerd Font not installed (run: termeric font)"
	fi

	echo ""
	if [ "$issues" -eq 0 ]; then
		_ok "All checks passed!"
	else
		_warn "$issues issue(s) found"
	fi
	echo ""

	# Toggle states
	echo ""
	local shell_name="$(_detect_shell)"
	printf "%b%b%b" "${BOLD}" "Toggle states" "${RESET}\n"
	echo "─────────────────────────────────────"

	_doctor_toggle() {
		local name="$1" default="$2" desc_func="$3"
		local env_val rc_val desc display_val env_set
		eval "env_set=\"\${$name+set}\""
		eval "env_val=\"\${$name:-$default}\""
		rc_val="$(_get_rc_val "$name" "$shell_name")"
		display_val="${rc_val:-$env_val}"
		if [ -n "$desc_func" ]; then
			desc="$("$desc_func" "$display_val")"
		fi
		if [ "$display_val" = "off" ] 2>/dev/null; then
			printf "  %-30s (disabled)" "${name}=${display_val}"
		else
			printf "  %-30s (${desc:-enabled})" "${name}=${display_val}"
		fi
		if [ "$env_set" = "set" ] && [ "$env_val" != "$display_val" ]; then
			printf " (session: %s)" "$env_val"
		fi
		printf "\n"
	}

	_doctor_toggle PROMPT_COLOR on ""
	_doctor_toggle PROMPT_SHOW_USER on ""
	_doctor_toggle PROMPT_SHOW_EXIT on ""
	_doctor_toggle PROMPT_SHOW_DIR on ""
	_doctor_toggle PROMPT_SHOW_SSH on ""
	_doctor_toggle PROMPT_SHOW_TIME off ""
	_doctor_toggle PROMPT_VENV off ""
	_doctor_toggle PROMPT_NODE off ""
	_doctor_toggle PROMPT_K8S off ""
	_doctor_toggle PROMPT_STYLE 0 _get_style_desc
	echo ""
}

# ── Version ─────────────────────────────────────────────────────
_cmd_version() {
	echo "termeric $TERMERIC_VERSION"
}

# ── Main ────────────────────────────────────────────────────────
case "${1:-help}" in
install)
	shift
	_cmd_install "$@"
	;;
uninstall) _cmd_uninstall ;;
update) _cmd_update ;;
config) _cmd_config ;;
status) _cmd_status ;;
ai) shift; _cmd_ai "$@" ;;
clear-cache) shift; _cmd_ai clear-cache "$@" ;;
font) _cmd_font ;;
doctor) _cmd_doctor ;;
version) _cmd_version ;;
help | -h | --help) _show_help ;;
*)
	_err "Unknown command: $1"
	_show_help
	exit 1
	;;
esac
