# termeric — Golden prompts for your terminal (zsh)
# Source: [ -f ~/.termeric_zsh ] && . ~/.termeric_zsh
#
# Configuration (set before sourcing):
#   PROMPT_COLOR=on        Master color switch: on (default) or off
#   PROMPT_STYLE=0         Prompt style: 0=powerline, 1=basename, 2=abbreviated, 3=full path, 4=long text (default: 0)
#   PROMPT_SHOW_USER=on    Show user@host segment (default: on)
#   PROMPT_SHOW_EXIT=on    Show exit code on failure (default: on)
#   PROMPT_SHOW_DIR=on     Show directory path (default: on)
#   PROMPT_SHOW_SSH=on     Show SSH indicator when connected (default: on)
#   PROMPT_SHOW_TIME=off   Show command duration when >=2s (default: off)
#   PROMPT_VENV=off        Show Python virtualenv/conda name (default: off)
#   PROMPT_NODE=off        Show Node.js version (default: off)
#   PROMPT_K8S=off         Show Kubernetes context (default: off)
#   ai()                   AI agent with Groq/Ollama/OpenAI (run 'ai help' in shell)

# ── Term detection (once) ──────────────────────────────────────
case "$TERM" in
    xterm-color|*-256color|*-truecolor) _tmerm_color=yes;;
esac

# ── Window title flag (evaluated once at source time) ──────────
case "$TERM" in xterm*|rxvt*) _tmerm_has_title=yes;; esac

zmodload zsh/datetime 2>/dev/null

# ── Validate PROMPT_STYLE ───────────────────────────────────────
case "${PROMPT_STYLE:-0}" in
    0|1|2|3|4) ;;
    *)
        echo "termeric: invalid PROMPT_STYLE=${PROMPT_STYLE:-empty}, defaulting to 1" >&2
        echo "  Valid styles:" >&2
        echo "    0  Powerline (background segments, arrows)" >&2
        echo "    1  Basename only" >&2
        echo "    2  Abbreviated path" >&2
        echo "    3  Full path (~/project/path)" >&2
        echo "    4  Long text prompt (user@host path git)" >&2
        PROMPT_STYLE=1
        ;;
esac

# ── Color definitions (runs at source time and on PROMPT_COLOR change) ──
__tmerm_init_colors() {
    if [ "${PROMPT_COLOR:-on}" != "off" ]; then
        E=$'\e'
        R="%{${E}[0m%}"

        BG_OK="%{${E}[48;2;60;60;60m%}";    ARROW_OK="%{${E}[38;2;0;210;0m%}"
        BG_FAIL="%{${E}[48;2;60;60;60m%}";  ARROW_FAIL="%{${E}[38;2;220;50;50m%}"
        BG_USER="%{${E}[48;2;50;100;220m%}";ARROW_USER="%{${E}[38;2;50;100;220m%}"
        BG_PATH="%{${E}[48;2;0;190;190m%}"; ARROW_PATH="%{${E}[38;2;0;190;190m%}"
        BG_GIT="%{${E}[48;2;220;180;0m%}";  ARROW_GIT="%{${E}[38;2;220;180;0m%}"
        BG_VENV="%{${E}[48;2;70;180;100m%}";  ARROW_VENV="%{${E}[38;2;70;180;100m%}"
        BG_NODE="%{${E}[48;2;60;160;120m%}";  ARROW_NODE="%{${E}[38;2;60;160;120m%}"
        BG_K8S="%{${E}[48;2;60;120;200m%}";   ARROW_K8S="%{${E}[38;2;60;120;200m%}"
        BG_TIME="%{${E}[48;2;200;50;200m%}";ARROW_TIME="%{${E}[38;2;200;50;200m%}"
        ARROW_BLACK="%{${E}[38;2;30;30;30m%}"
        ARROW_DARK="%{${E}[38;2;60;60;60m%}"
        TXT_BG="%{${E}[38;2;255;255;255m%}"
        TXT_BG_LIT="%{${E}[38;2;0;0;0m%}"

        TXT_OK="%F{green}"
        TXT_FAIL="%B%F{red}"
        RCOLOR="%f%b"
        PROMPT_SEP_GREEN="%F{green}"
        TXT_USER="%F{green}"
        TXT_PATH="%F{blue}"
        TXT_GIT="%F{yellow}"
        TXT_VENV="%F{green}"
        TXT_NODE="%F{green}"
        TXT_K8S="%F{blue}"
        TXT_TIME="%F{cyan}"
        PSEP=
        PSEP_LEFT=
    else
        R=""
        BG_OK="";    ARROW_OK=""
        BG_FAIL="";  ARROW_FAIL=""
        BG_USER="";  ARROW_USER=""
        BG_PATH="";  ARROW_PATH=""
        BG_GIT="";   ARROW_GIT=""
        BG_VENV="";  ARROW_VENV=""
        BG_NODE="";  ARROW_NODE=""
        BG_K8S="";   ARROW_K8S=""
        BG_TIME="";  ARROW_TIME=""
        ARROW_BLACK=""; ARROW_DARK=""
        TXT_BG="";   TXT_BG_LIT=""
        TXT_OK="";   TXT_FAIL=""
        RCOLOR=""
        PROMPT_SEP_GREEN=""
        TXT_USER=""; TXT_PATH=""
        TXT_GIT="";  TXT_VENV=""; TXT_NODE=""; TXT_K8S=""; TXT_TIME=""
        PSEP="";     PSEP_LEFT=""
    fi
}

if [ "$_tmerm_color" = yes ]; then
    __tmerm_init_colors
fi

# ── Command duration tracking ──────────────────────────────────
typeset -gF __tmerm_timer=0

__tmerm_cmd_start() {
    __tmerm_timer=$EPOCHREALTIME
}
preexec_functions+=(__tmerm_cmd_start)

# ── Path shortening (for PROMPT_STYLE) ─────────────────────────
__tmerm_shortened_path() {
    local level=${1:-0}
    [[ "$level" == 0 || "$level" == 3 ]] && { print -P '%~'; return }
    local p="${PWD/#$HOME/~}"
    case "$level" in
        1) print "${p##*/}" ;;
        2)
            local parts=(${(s:/:)p})
            local out="" i
            local last_idx=$#parts
            if [[ "${parts[1]}" == "" ]]; then
                for ((i=2; i<last_idx; i++)); do
                    out+="${parts[$i][1]}/"
                done
                print "/${out}${parts[$last_idx]}"
            else
                for ((i=1; i<last_idx; i++)); do
                    out+="${parts[$i][1]}/"
                done
                print "${out}${parts[$last_idx]}"
            fi
            ;;
    esac
}

# ── Git info via cache (avoids fork when unchanged) ────────────
__tmerm_git_info() {
    setopt localoptions noxtrace 2>/dev/null
    # Fast exit: not in a git repo
    git rev-parse --is-inside-work-tree &>/dev/null || return

    local git_dir
    git_dir=$(git rev-parse --git-dir 2>/dev/null) || return

    local head_file="$git_dir/HEAD"
    local index_file="$git_dir/index"

    # Cache dir (XDG compliant, per-repo via md5 hash of toplevel path)
    local repo_hash
    repo_hash=$(git rev-parse --show-toplevel 2>/dev/null | md5 -q 2>/dev/null || git rev-parse --show-toplevel 2>/dev/null | md5sum | cut -d' ' -f1 2>/dev/null)
    [[ -z "$repo_hash" ]] && return
    local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/termeric"
    mkdir -p "$cache_dir" 2>/dev/null
    local cache_file="$cache_dir/$repo_hash.cache"
    local result_file="$cache_dir/$repo_hash.result"

    # Check cache validity
    if [[ -f "$cache_file" ]]; then
        local cached_head cached_index
        read -r cached_head cached_index < "$cache_file" 2>/dev/null
        local cur_head cur_index
        cur_head=$(stat -c '%Y' "$head_file" 2>/dev/null || stat -f '%m' "$head_file" 2>/dev/null)
        cur_index=$(stat -c '%Y' "$index_file" 2>/dev/null || stat -f '%m' "$index_file" 2>/dev/null)
        if [[ "$cur_head" == "$cached_head" && "$cur_index" == "$cached_index" ]]; then
            if [[ -f "$result_file" ]]; then
                cat "$result_file"
                return
            fi
        fi
    fi

    # Cache miss
    local branch="" staged=0 unstaged=0 untracked=0 ahead=0 behind=0
    local line

    while IFS= read -r line; do
        if [[ "$line" == "## "* ]]; then
            local branch_line="${line#\#\# }"
            branch="${branch_line%%...*}"
            if [[ "$branch_line" =~ ahead\ ([0-9]+) ]]; then ahead="${match[1]}"; fi
            if [[ "$branch_line" =~ behind\ ([0-9]+) ]]; then behind="${match[1]}"; fi
        elif [[ "$line" == "?? "* ]]; then
            untracked=$(( untracked + 1 ))
        else
            local x="${line:0:1}" y="${line:1:1}"
            case "$x" in M|A|D|R|C) staged=$(( staged + 1 )) ;; esac
            case "$y" in M|A|D|R|C) unstaged=$(( unstaged + 1 )) ;; esac
        fi
    done < <(git status --porcelain -b 2>/dev/null) || return

    [[ -z "$branch" ]] && return

    local out=" $branch"
    local details=""
    [[ "$ahead" -gt 0 ]]   && details+=" $ahead "
    [[ "$behind" -gt 0 ]]  && details+=" $behind "
    [[ "$staged" -gt 0 ]]  && details+=" $staged "
    [[ "$unstaged" -gt 0 ]] && details+=" $unstaged "
    [[ "$untracked" -gt 0 ]] && details+=" $untracked "
    details="${details% }"
    [[ -n "$details" ]] && out+=" $details"

    print "$out"

    # Write cache
    local cur_head cur_index
    cur_head=$(stat -f '%m' "$head_file" 2>/dev/null || stat -c '%Y' "$head_file" 2>/dev/null)
    cur_index=$(stat -f '%m' "$index_file" 2>/dev/null || stat -c '%Y' "$index_file" 2>/dev/null)
    printf '%s %s\n' "$cur_head" "$cur_index" > "$cache_file"
    printf '%s' "$out" > "$result_file"
    # Clean up old per-repo cache files
    rm -f "$git_dir/.termeric_cache" "$git_dir/.termeric_result" 2>/dev/null
}

# ── Virtual environment info ────────────────────────────────────
__tmerm_venv_info() {
    local venv=""
    [ -n "${VIRTUAL_ENV:-}" ] && venv=$(basename "$VIRTUAL_ENV")
    [ -z "$venv" ] && [ -n "${CONDA_DEFAULT_ENV:-}" ] && venv="$CONDA_DEFAULT_ENV"
    [ -n "$venv" ] && print ' '"$venv"
}

# ── Node.js version info ────────────────────────────────────────
__tmerm_node_info() {
    (( $+commands[node] )) || return
    local ver
    ver=$(node --version 2>/dev/null) || return
    print ' '"${ver#v}"
}

# ── Kubernetes context info ─────────────────────────────────────
__tmerm_k8s_info() {
    (( $+commands[kubectl] )) || return
    local ctx
    ctx=$(kubectl config current-context 2>/dev/null) || return
    local ns
    ns=$(kubectl config view --minify -o jsonpath='{..namespace}' 2>/dev/null)
    if [ -n "$ns" ]; then
        print '☸ '"$ctx:$ns"
    else
        print '☸ '"$ctx"
    fi
}

# ── Prompt builder ──────────────────────────────────────────────
__termeric_prompt() {
    local rc=$?
    setopt localoptions noxtrace 2>/dev/null
    local data=""
    local arrow=""
    local style="${PROMPT_STYLE:-0}"

    # Runtime style validation
    case "$style" in
        0|1|2|3|4) ;;
        *)
            if [ -z "${_tmerm_style_warned:-}" ]; then
                echo "termeric: invalid PROMPT_STYLE=${PROMPT_STYLE:-empty}, defaulting to 1" >&2
                echo "  Valid styles:" >&2
                echo "    0  Powerline (background segments, arrows)" >&2
                echo "    1  Basename only" >&2
                echo "    2  Abbreviated path" >&2
                echo "    3  Full path (~/project/path)" >&2
                echo "    4  Long text prompt (user@host path git)" >&2
                _tmerm_style_warned=1
            fi
            style=1
            ;;
    esac

    # Window title
    [[ "$_tmerm_has_title" == yes ]] && data+=$'%{\e]0;%n@%m: %~\a%}'

    # Initialize colors if terminal supports it
    if [ "$_tmerm_color" = yes ]; then
        __tmerm_init_colors
    fi

    # Style 4: long text prompt without background colors
    if [ "$style" = "4" ]; then
        if [ "$rc" -ne 0 ] && [ "${PROMPT_SHOW_EXIT:-on}" != "off" ]; then
            data+="${TXT_FAIL}✘ $rc${RCOLOR} "
        fi
        if [ "${PROMPT_SHOW_USER:-on}" != "off" ]; then
            if [ "${PROMPT_SHOW_SSH:-on}" != "off" ] && [ -n "$SSH_CONNECTION" ]; then
                data+="${TXT_USER}%n@ssh:%m${RCOLOR} "
            else
                data+="${TXT_USER}%n@%m${RCOLOR} "
            fi
        fi
        if [ "${PROMPT_SHOW_DIR:-on}" != "off" ]; then
            data+="${TXT_PATH}%~${RCOLOR}"
        fi
        local git_info
        git_info=$(__tmerm_git_info 2>/dev/null)
        [[ -n "$git_info" ]] && data+=" ${TXT_GIT}$git_info${RCOLOR}"
        local venv_info
        venv_info=$(__tmerm_venv_info 2>/dev/null)
        [[ -n "$venv_info" ]] && data+=" ${TXT_VENV}$venv_info${RCOLOR}"
        local node_info
        node_info=$(__tmerm_node_info 2>/dev/null)
        [[ -n "$node_info" ]] && data+=" ${TXT_NODE}$node_info${RCOLOR}"
        local k8s_info
        k8s_info=$(__tmerm_k8s_info 2>/dev/null)
        [[ -n "$k8s_info" ]] && data+=" ${TXT_K8S}$k8s_info${RCOLOR}"
        if [ "${PROMPT_SHOW_TIME:-off}" != "off" ] && (( __tmerm_timer > 0 )); then
            local duration=$(( EPOCHREALTIME - __tmerm_timer ))
            (( duration >= 2 )) && data+=" ${TXT_TIME}[${duration%.*}s]${RCOLOR}"
        fi
        PROMPT="${data}"$'\n'"${PROMPT_SEP_GREEN}❯❯ ${RCOLOR}"
        __tmerm_timer=0
        return "$rc"
    fi

    # Styles 1, 2: shortened path prompts
    if [ "$style" != "0" ]; then
        local spath
        spath=$(__tmerm_shortened_path "$style")
        if [ "$rc" -ne 0 ] && [ "${PROMPT_SHOW_EXIT:-on}" != "off" ]; then
            data+="${TXT_FAIL}✘ $rc${RCOLOR} "
        fi
        if [ "${PROMPT_SHOW_DIR:-on}" != "off" ]; then
            data+="${TXT_PATH}  ${spath}${RCOLOR}"
        else
            data+="${TXT_PATH}${spath}${RCOLOR}"
        fi
        local git_info
        git_info=$(__tmerm_git_info 2>/dev/null)
        [[ -n "$git_info" ]] && data+=" ${TXT_GIT}$git_info${RCOLOR}"
        local venv_info
        venv_info=$(__tmerm_venv_info 2>/dev/null)
        [[ -n "$venv_info" ]] && data+=" ${TXT_VENV}$venv_info${RCOLOR}"
        local node_info
        node_info=$(__tmerm_node_info 2>/dev/null)
        [[ -n "$node_info" ]] && data+=" ${TXT_NODE}$node_info${RCOLOR}"
        local k8s_info
        k8s_info=$(__tmerm_k8s_info 2>/dev/null)
        [[ -n "$k8s_info" ]] && data+=" ${TXT_K8S}$k8s_info${RCOLOR}"
        PROMPT="${data}"$'\n'"${PROMPT_SEP_GREEN}❯❯ ${RCOLOR}"
        __tmerm_timer=0
        return "$rc"
    fi

    # Style 0: powerline or monochrome
    if [ "$_tmerm_color" = yes ] && [ "${PROMPT_COLOR:-on}" != "off" ]; then
        # ── POWERLINE MODE ──
        local psep=$PSEP

        # Exit code (only show on failure) — first segment
        if [ "$rc" -ne 0 ] && [ "${PROMPT_SHOW_EXIT:-on}" != "off" ]; then
            data+="${BG_FAIL} ${BG_FAIL}${ARROW_DARK}${psep}${BG_FAIL}${TXT_FAIL} ✘ $rc ${R}"
            arrow="${ARROW_DARK}"
        fi

        # Session
        if [ "${PROMPT_SHOW_USER:-on}" != "off" ]; then
            if [ -n "$arrow" ]; then
                data+="${BG_USER}${arrow}${psep}${R}${BG_USER}${TXT_BG}"
            else
                data+="${BG_FAIL} ${BG_USER}${ARROW_DARK}${psep}${BG_USER}${TXT_BG}"
            fi
            if [ "${PROMPT_SHOW_SSH:-on}" != "off" ] && [ -n "$SSH_CONNECTION" ]; then
                data+=" %n@ssh:%m ${R}"
            else
                data+=" %n@%m ${R}"
            fi
            arrow="${ARROW_USER}"
        fi

        # Path
        if [ "${PROMPT_SHOW_DIR:-on}" != "off" ]; then
            if [ -n "$arrow" ]; then
                data+="${BG_PATH}${arrow}${psep}${R}${BG_PATH}${TXT_BG_LIT}"
            else
                data+="${BG_FAIL} ${BG_PATH}${ARROW_DARK}${psep}${BG_PATH}${TXT_BG_LIT}"
            fi
            data+=" %~ ${R}"
            arrow="${ARROW_PATH}"
        fi

        # Git
        local git_info
        git_info=$(__tmerm_git_info 2>/dev/null)
        if [ -n "$git_info" ]; then
            if [ -n "$arrow" ]; then
                data+="${BG_GIT}${arrow}${psep}${R}${BG_GIT}${TXT_BG_LIT}"
            else
                data+="${BG_FAIL} ${BG_GIT}${ARROW_DARK}${psep}${BG_GIT}${TXT_BG_LIT}"
            fi
            data+=" $git_info ${R}"
            arrow="${ARROW_GIT}"
        fi

        # Virtual env
        if [ "${PROMPT_VENV:-off}" != "off" ]; then
            local venv_info
            venv_info=$(__tmerm_venv_info 2>/dev/null)
            if [ -n "$venv_info" ]; then
                if [ -n "$arrow" ]; then
                    data+="${BG_VENV}${arrow}${psep}${R}${BG_VENV}${TXT_BG}"
                else
                    data+="${BG_FAIL} ${BG_VENV}${ARROW_DARK}${psep}${BG_VENV}${TXT_BG}"
                fi
                data+=" $venv_info ${R}"
                arrow="${ARROW_VENV}"
            fi
        fi

        # Node.js
        if [ "${PROMPT_NODE:-off}" != "off" ]; then
            local node_info
            node_info=$(__tmerm_node_info 2>/dev/null)
            if [ -n "$node_info" ]; then
                if [ -n "$arrow" ]; then
                    data+="${BG_NODE}${arrow}${psep}${R}${BG_NODE}${TXT_BG}"
                else
                    data+="${BG_FAIL} ${BG_NODE}${ARROW_DARK}${psep}${BG_NODE}${TXT_BG}"
                fi
                data+=" $node_info ${R}"
                arrow="${ARROW_NODE}"
            fi
        fi

        # Kubernetes
        if [ "${PROMPT_K8S:-off}" != "off" ]; then
            local k8s_info
            k8s_info=$(__tmerm_k8s_info 2>/dev/null)
            if [ -n "$k8s_info" ]; then
                if [ -n "$arrow" ]; then
                    data+="${BG_K8S}${arrow}${psep}${R}${BG_K8S}${TXT_BG}"
                else
                    data+="${BG_FAIL} ${BG_K8S}${ARROW_DARK}${psep}${BG_K8S}${TXT_BG}"
                fi
                data+=" $k8s_info ${R}"
                arrow="${ARROW_K8S}"
            fi
        fi

        # Timing
        if [ "${PROMPT_SHOW_TIME:-off}" != "off" ] && (( __tmerm_timer > 0 )); then
            local duration=$(( EPOCHREALTIME - __tmerm_timer ))
            if (( duration >= 2 )); then
                if [ -n "$arrow" ]; then
                    data+="${BG_TIME}${arrow}${psep}${R}${BG_TIME}${TXT_BG}"
                else
                    data+="${BG_FAIL} ${BG_TIME}${ARROW_DARK}${psep}${BG_TIME}${TXT_BG}"
                fi
                data+=" ${duration%.*}s ${R}"
                arrow="${ARROW_TIME}"
            fi
        fi

        # Trailing separator
        [[ -n "$arrow" ]] && data+="${arrow}${psep}${R}"

        PROMPT="${data}"$'\n'"${PROMPT_SEP_GREEN}❯❯ ${RCOLOR}"
    else
        # ── MONOCHROME MODE ──
        # data already has window title from above

        if [ "$rc" -ne 0 ] && [ "${PROMPT_SHOW_EXIT:-on}" != "off" ]; then
            data="✘ $rc $data"
        fi

        if [ "${PROMPT_SHOW_USER:-on}" != "off" ]; then
            if [ "${PROMPT_SHOW_SSH:-on}" != "off" ] && [ -n "$SSH_CONNECTION" ]; then
                data+="%n@ssh:%m:"
            else
                data+="%n@%m:"
            fi
        fi

        if [ "${PROMPT_SHOW_DIR:-on}" != "off" ]; then
            data+="%~"
        fi

        local git_info
        git_info=$(__tmerm_git_info 2>/dev/null)
        [[ -n "$git_info" ]] && data+=" ($git_info)"

        local venv_info
        venv_info=$(__tmerm_venv_info 2>/dev/null)
        [[ -n "$venv_info" ]] && data+=" $venv_info"
        local node_info
        node_info=$(__tmerm_node_info 2>/dev/null)
        [[ -n "$node_info" ]] && data+=" $node_info"
        local k8s_info
        k8s_info=$(__tmerm_k8s_info 2>/dev/null)
        [[ -n "$k8s_info" ]] && data+=" $k8s_info"

        if [ "${PROMPT_SHOW_TIME:-off}" != "off" ] && (( __tmerm_timer > 0 )); then
            local duration=$(( EPOCHREALTIME - __tmerm_timer ))
            (( duration >= 2 )) && data+=" [${duration%.*}s]"
        fi

        PROMPT="${data}"$'\n'"❯❯ "
    fi

    __tmerm_timer=0
    return "$rc"
}
precmd_functions+=(__termeric_prompt)

# ── AI agent ─────────────────────────────────────────────────────
ai() {
  if [ $# -eq 0 ]; then
    printf "Usage: ai [--noctx] <query>\n"
    printf "  Talk to the AI agent directly from your shell\n"
    return 1
  fi
  local cmd noctx=0 args=() arg
  for arg in "$@"; do
    if [ "$arg" = "--noctx" ]; then noctx=1; else args+=("$arg"); fi
  done
  if [ ${#args[@]} -eq 0 ]; then
    printf "Usage: ai [--noctx] <query>\n"
    return 1
  fi
  cmd=$(command -v termeric 2>/dev/null) || cmd="$HOME/.local/bin/termeric"
  if [ ! -x "$cmd" ]; then
    echo "termeric not found in PATH. Run 'termeric install' first." >&2
    return 1
  fi
  local query="${args[*]}"
  if [ "$noctx" -eq 0 ]; then
    local ctx_dir ctx_git ctx_git_status ctx_hist ctx_info
    ctx_dir="${PWD/#$HOME/~}"
    ctx_git=$(git branch --show-current 2>/dev/null) || ctx_git=""
    if [ -n "$ctx_git" ]; then
      ctx_info="pwd: $ctx_dir | git: $ctx_git"
      ctx_git_status=$(git status --short 2>/dev/null | head -5)
      if [ -n "$ctx_git_status" ]; then
        ctx_info="$ctx_info [$(echo "$ctx_git_status" | wc -l) changes]"
      fi
    else
      ctx_info="pwd: $ctx_dir"
    fi
    ctx_hist=$(fc -ln -3 2>/dev/null | tr '\n' '; ' || true)
    [ -n "$ctx_hist" ] && ctx_info="$ctx_info | hist: $ctx_hist"
    query="[ctx: $ctx_info] $query"
  fi
  "$cmd" ai agent --noctx "$query"
}

# ── @ prefix intercept ─────────────────────────────────────────
_termeric_accept_line() {
  local buf="$BUFFER"
  if [[ "$buf" =~ ^@(.+)$ ]]; then
    BUFFER="ai ${match[1]}"
  fi
  zle .accept-line
}
zle -N accept-line _termeric_accept_line
